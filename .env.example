API_URL=<api-url>

# Account API base (used by the "List your platform" form). Optional — falls back
# to the production account API when unset.
# API_ACCOUNT_URL=https://monierate-account-api.onrender.com/core

# Shared service secret. Must match SERVICE_TOKEN on the account-api so the
# server-to-server listing endpoint accepts requests from this site.
SERVICE_TOKEN=<service-token>

# Cloudflare Turnstile (bot protection on the listing form).
# Set BOTH to enable it; leave unset to disable (honeypot + service token still apply).
PUBLIC_TURNSTILE_SITE_KEY=<turnstile-site-key>
TURNSTILE_SECRET_KEY=<turnstile-secret-key>
