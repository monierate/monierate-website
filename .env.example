API_URL=<api-url>

# Account API base (used by the "List your platform" form and the converter's
# rate lookups). Optional — falls back to the production account API when unset.
# API_ACCOUNT_URL=https://monierate-account-api.onrender.com/core

# Account API key for /rates/latest, which powers the global converter's parallel
# and mid-market rates. Server-only: it is read in src/lib/api/accountApi.ts and
# reached exclusively through the /api/rates/latest proxy, so it never ships to a
# browser. Unset, the converter still renders but shows no rates.
#
# Provision it on a plan where FeatureCode.RateQuote is NOT metered per call —
# the endpoint is wrapped in chargeable(), so a usage-billed key would bill once
# per cache miss.
ACCOUNT_API_KEY=<account-api-key>

# Shared service secret. Must match SERVICE_TOKEN on the account-api so the
# server-to-server listing endpoint accepts requests from this site.
SERVICE_TOKEN=<service-token>

# Cloudflare Turnstile (bot protection on the listing form).
# Set BOTH to enable it; leave unset to disable (honeypot + service token still apply).
PUBLIC_TURNSTILE_SITE_KEY=<turnstile-site-key>
TURNSTILE_SECRET_KEY=<turnstile-secret-key>
